# ── API Keys ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model Configs (all optional, defaults shown) ──────────
EMBEDDING_MODEL_NAME=gemini-embedding-001
LLM_MODEL=gemini-3.8-flash
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# ── Paths ─────────────────────────────────────────────────
PRODUCT_CSV_PATH=src/data/product.csv
FAISS_TEXT_PATH=embeddings/text_index.faiss
FAISS_IMAGE_PATH=embeddings/image_index.faiss
FAISS_TABLE_PATH=embeddings/table_index.faiss
METADATA_PATH=embeddings/metadata.json

# ── Retrieval ─────────────────────────────────────────────
# Cosine similarity floor for dense results (see src/config.py)
MIN_SIMILARITY=0.65
RETRIEVAL_K=5
CANDIDATE_POOL=30
RRF_K=60
SEARCH_MODE=hybrid          # bm25 | dense | hybrid
FAISS_INDEX_TYPE=flat       # flat | hnsw

# ── LLM ───────────────────────────────────────────────────
LLM_TEMPERATURE=0.3
